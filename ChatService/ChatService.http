@ChatService_HostAddress = http://localhost:5210

POST {{ChatService_HostAddress}}/api/chats
Content-Type: application/json

{
  "name": "Min første chat",
  "createdByUserId": "11111111-1111-1111-1111-111111111111",
  "participantUserIds": [
    "22222222-2222-2222-2222-222222222222",
    "33333333-3333-3333-3333-333333333333"
  ]
}

###

# Hent én chat med medlemmer (indsæt et id fra svaret på POST ovenfor)
GET {{ChatService_HostAddress}}/api/chats/00000000-0000-0000-0000-000000000000

###

# Mine chats (userId er Test Bruger, indtil der findes login)
GET {{ChatService_HostAddress}}/api/chats?userId=11111111-1111-1111-1111-111111111111

###

# Send en besked (indsæt et chat-id, hvor afsenderen er medlem)
POST {{ChatService_HostAddress}}/api/chats/00000000-0000-0000-0000-000000000000/messages
Content-Type: application/json

{
  "senderUserId": "11111111-1111-1111-1111-111111111111",
  "content": "Hej med jer!"
}

###
