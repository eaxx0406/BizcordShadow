<!DOCTYPE html>
<html lang="da" data-bs-theme="dark">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Bizcord</title>
    <script type="importmap"></script>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700&display=swap" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Bizcord.styles.css" asp-append-version="true" />
</head>
@{
    var active = ViewData["ActiveNav"] as string;
}
<body>
    <div class="bz-app">
        <aside class="bz-sidebar">
            <a class="bz-brand" asp-page="/Index" aria-label="Bizcord forside">
                <img src="~/img/logo-icon.png" alt="" />
                <span>Biz<span class="brand-gradient">cord</span></span>
            </a>

            <nav class="bz-nav">
                <a class="bz-nav-link @(active == "Kanaler" ? "active" : "")" asp-page="/Index">
                    <i class="bi bi-hash" aria-hidden="true"></i> Kanaler
                </a>
                <a class="bz-nav-link @(active == "Chat" ? "active" : "")" asp-page="/Chat">
                    <i class="bi bi-chat-dots" aria-hidden="true"></i> Chat
                    <span class="bz-badge" aria-label="1 ulæst">1</span>
                </a>
                <a class="bz-nav-link" href="#" aria-disabled="true">
                    <i class="bi bi-person" aria-hidden="true"></i> Profil
                </a>
            </nav>
        </aside>

        <div class="bz-main">
            <header class="bz-topbar">
                <button type="button" class="bz-icon-btn" aria-label="Notifikationer">
                    <i class="bi bi-bell" aria-hidden="true"></i>
                </button>
                <button type="button" class="bz-icon-btn bz-avatar" aria-label="Profil">
                    <i class="bi bi-person-circle" aria-hidden="true"></i>
                    <span class="bz-online" aria-hidden="true"></span>
                </button>
            </header>

            <main role="main" class="bz-content">
                @RenderBody()
            </main>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
