{
  "Routes": [
    {
      "UpstreamPathTemplate": "/api/chats", // The path that the client will use to access the API Gateway
      "UpstreamHttpMethod": [ "GET", "POST"], // The HTTP methods that the client can use to access the API Gateway
      "DownstreamPathTemplate": "/api/chats", // The path that the API Gateway will use to access the downstream service
      "DownstreamScheme": "http", // The scheme that the API Gateway will use to access the downstream service
      "DownstreamHostAndPorts": [
        {
          "Host": "localhost", // The host of the downstream service
          "Port": 5210 // The port of the downstream service
        }
      ]
    },
    {
      // Tilføj deltager til en chat (ADR 0010). Én route per sti: gatewayen er en hvidliste.
      "UpstreamPathTemplate": "/api/chats/{chatId}/participants", // {chatId} er en pladsholder, der fanger ét stykke af stien
      "UpstreamHttpMethod": [ "POST" ], // Kun POST: der findes ikke andre metoder på denne sti endnu
      "DownstreamPathTemplate": "/api/chats/{chatId}/participants", // Ocelot sætter samme {chatId} ind her
      "DownstreamScheme": "http", // The scheme that the API Gateway will use to access the downstream service
      "DownstreamHostAndPorts": [
        {
          "Host": "localhost", // The host of the downstream service
          "Port": 5210 // The port of the downstream service
        }
      ]
    },
    {
      // Hent én chat med medlemmer
      "UpstreamPathTemplate": "/api/chats/{chatId}",
      "UpstreamHttpMethod": [ "GET" ],
      "DownstreamPathTemplate": "/api/chats/{chatId}",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [
        {
          "Host": "localhost",
          "Port": 5210
        }
      ]
    },
    {
      // Send en besked i en chat
      "UpstreamPathTemplate": "/api/chats/{chatId}/messages",
      "UpstreamHttpMethod": [ "POST" ],
      "DownstreamPathTemplate": "/api/chats/{chatId}/messages",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [
        {
          "Host": "localhost",
          "Port": 5210
        }
      ]
    }
  ],
  "GlobalConfiguration": {
    "BaseUrl": "http://localhost:5065" // The address of the API Gateway itself
  }
}
