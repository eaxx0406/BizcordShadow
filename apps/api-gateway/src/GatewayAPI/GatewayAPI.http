@GatewayAPI_HostAddress = http://localhost:5065

# Create chat via gatewayen (Ocelot sender videre til ChatService på :5210)
POST {{GatewayAPI_HostAddress}}/api/chats
Content-Type: application/json

{
  "name": "Chat via gateway",
  "createdByUserId": "10000000-0000-0000-0000-000000000001",
  "participantUserIds": [
    "10000000-0000-0000-0000-000000000002"
  ]
}

