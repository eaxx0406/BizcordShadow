@ChatService_HostAddress = http://localhost:5210

POST {{ChatService_HostAddress}}/api/chats
Content-Type: application/json

{
  "name": "Min første chat",
  "createdByUserId": "10000000-0000-0000-0000-000000000001",
  "participantUserIds": [
    "10000000-0000-0000-0000-000000000002",
    "10000000-0000-0000-0000-000000000003"
  ]
}

###

# Hent én chat med medlemmer (indsæt et id fra svaret på POST ovenfor)
GET {{ChatService_HostAddress}}/api/chats/00000000-0000-0000-0000-000000000000?userId=10000000-0000-0000-0000-000000000001

###

# Mine chats (userId er Test Bruger, indtil der findes login)
GET {{ChatService_HostAddress}}/api/chats?userId=10000000-0000-0000-0000-000000000001

###

# Send en besked (indsæt et chat-id, hvor afsenderen er medlem)
POST {{ChatService_HostAddress}}/api/chats/00000000-0000-0000-0000-000000000000/messages
Content-Type: application/json

{
  "senderUserId": "10000000-0000-0000-0000-000000000001",
  "content": "Hej med jer!"
}

###

# Læs beskeder: de 30 nyeste. Ældre: tilføj &before=<id på den ældste besked, du har>
GET {{ChatService_HostAddress}}/api/chats/00000000-0000-0000-0000-000000000000/messages?userId=10000000-0000-0000-0000-000000000001&limit=30

###
