@page
@model IndexModel
@{
    ViewData["Title"] = "Velkommen";
    ViewData["ActiveNav"] = "Kanaler";
}

<section class="welcome">
    <img class="welcome-hero" src="~/img/mascot-scene.png" alt="Bizcord-maskotten ved sin computer med en tjekliste: Opret en kanal, Invitér venner, Start en samtale" />

    <h1 class="welcome-title">Velkommen til Biz<span class="brand-gradient">cord</span></h1>
    <p class="welcome-text">
        Her er der stadig lidt tomt …<br />
        Kom i gang ved at oprette eller deltage i en kanal.
    </p>

    <div class="welcome-actions">
        <a class="bz-action bz-action-primary" asp-page="/Chat">
            <i class="bi bi-plus-circle" aria-hidden="true"></i>
            <span>
                <strong>Opret en kanal</strong>
                <small>Start dit eget fællesskab</small>
            </span>
        </a>
        <a class="bz-action bz-action-secondary" asp-page="/Chat">
            <i class="bi bi-people" aria-hidden="true"></i>
            <span>
                <strong>Deltag i en kanal</strong>
                <small>Brug en invitation</small>
            </span>
        </a>
    </div>

    <p class="welcome-hint">
        <i class="bi bi-chat-dots" aria-hidden="true"></i>
        Du kan også starte en privat samtale fra <a asp-page="/Chat">Chat.</a>
    </p>
</section>
