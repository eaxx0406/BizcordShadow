@model Bizcord.Models.MessageList
@*
    Én side beskeder (ældste først). Bruges både når chatten åbnes, og når "Vis ældre beskeder" henter en side mere.
    Knappen husker id'et på den ældste besked; det er cursoren til næste side (ADR 0014).
*@
@if (Model.HasOlder && Model.Messages.Count > 0)
{
    <button type="button" class="btn btn-sm btn-outline-light msg-load-older" data-before="@Model.Messages[0].Id">
        <i class="bi bi-arrow-up" aria-hidden="true"></i> Vis ældre beskeder
    </button>
}
@foreach (var message in Model.Messages)
{
    var mine = message.SenderUserId == Model.CurrentUserId;
    <div class="msg @(mine ? "msg-mine" : "") @(message.IsDeleted ? "msg-deleted" : "")">
        @if (!mine)
        {
            <span class="msg-sender">@message.SenderName</span>
        }
        @if (message.IsDeleted)
        {
            <!-- Slettet (ADR 0020): beskeden bliver stående, så samtalen giver mening, men indholdet er væk -->
            <div class="msg-bubble"><i class="bi bi-trash3" aria-hidden="true"></i> Beskeden er slettet</div>
        }
        else
        {
            <div class="msg-bubble">@message.Content</div>
        }
        <div class="msg-meta">
            <time class="msg-time" datetime="@message.SentAt.ToString("o")">@Bizcord.Models.MessageList.FormatTime(message.SentAt)</time>
            @if (mine && !message.IsDeleted)
            {
                <!-- Kun egne beskeder kan slettes (reglen håndhæves også i ChatService) -->
                <form method="post" asp-page="/Chat" asp-page-handler="DeleteMessage" asp-route-id="@Model.ChatId" class="msg-delete-form">
                    <input type="hidden" name="messageId" value="@message.Id" />
                    <button type="submit" class="msg-delete" title="Slet besked" aria-label="Slet besked">
                        <i class="bi bi-trash3" aria-hidden="true"></i>
                    </button>
                </form>
            }
        </div>
    </div>
}
